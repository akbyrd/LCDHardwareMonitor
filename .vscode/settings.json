{
	"files.exclude": {
		".git": true,
	},

	"search.exclude": {
		"modules": true,
		"build":   true,
	},

	"dotnet.defaultSolution": "build/msbuild/LCDHardwareMonitor.sln",

	"C_Cpp.default.compilerPath": "cl.exe",
	"C_Cpp.default.compilerArgs": [
		"/clr",
		"/AIC:/Program Files (x86)/Reference Assemblies/Microsoft/Framework/.NETFramework/v4.7.2",
		"/FUSystem.dll",
		"/FUSystem.Core.dll",
		"/FUWindowsBase.dll",
		"/FUPresentationCore.dll",
		"/FU${workspaceFolder}/cache/build/windows-x64-Debug-msvc/LCDHardwareMonitor API CLR/bin/LCDHardwareMonitor.API.CLR.dll",
		"/FU${workspaceFolder}/cache/build/windows-x64-Debug-msvc/LCDHardwareMonitor PluginLoader CLR Interface/bin/LCDHardwareMonitor.PluginLoader.CLR.Interface.dll",
	],
	"C_Cpp.default.cppStandard": "c++17",
	"C_Cpp.default.intelliSenseMode": "msvc-x64",
	"C_Cpp.default.includePath": [
		"C:/Program Files (x86)/Windows Kits/NETFXSDK/4.8/Include/um",
		"${workspaceFolder}/LCDHardwareMonitor/include",
		"${workspaceFolder}/LCDHardwareMonitor/src",
		"${workspaceFolder}/LCDHardwareMonitor/ext/d2xx/include",
		"${workspaceFolder}/modules/keel",
		"${workspaceFolder}/cache/build/windows-x64-Debug-msvc/LCDHardwareMonitor PluginLoader CLR Interface/bin",
	],
}
